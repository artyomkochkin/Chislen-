#include <iostream>
#include <iomanip>
#include <cmath>

using namespace std;

double Gauss(double y[], double q)
{
    double d[7][7];

    // Записываем значения функции
    for (int i = 0; i < 7; i++)
        d[i][0] = y[i];

    // Таблица конечных разностей
    for (int j = 1; j < 7; j++)
        for (int i = 0; i < 7 - j; i++)
            d[i][j] = d[i + 1][j - 1] - d[i][j - 1];

    // Вторая интерполяционная формула Гаусса
    double P = d[3][0];

    P += q * d[2][1];

    P += q * (q + 1) / 2.0 * d[2][2];

    P += (q + 1) * q * (q - 1) / 6.0 * d[1][3];

    P += (q + 2) * (q + 1) * q * (q - 1)
         / 24.0 * d[1][4];

    P += (q + 3) * (q + 2) * (q + 1) * q * (q - 1)
         / 120.0 * d[0][5];

    P += (q + 3) * (q + 2) * (q + 1) * q * (q - 1) * (q - 2)
         / 720.0 * d[0][6];

    return P;
}

int main()
{
    setlocale(LC_ALL, "Russian");

    double x[7] = {0.4, 0.7, 1.0, 1.3, 1.6, 1.9, 2.2};

    double y1[7];
    double y2[7];

    for (int i = 0; i < 7; i++)
    {
        y1[i] = 1.0 / x[i];
        y2[i] = pow(x[i], 5);
    }

    // Заданная точка
    double X = 1.1;

    // Центральный узел
    double x0 = 1.3;

    // Шаг
    double h = 0.3;

    // Параметр q
    double q = (X - x0) / h;

    cout << fixed << setprecision(6);

    cout << "Вторая интерполяционная формула Гаусса\n";
    cout << "x0 = " << x0 << endl;
    cout << "h = " << h << endl;
    cout << "x = " << X << endl;
    cout << "q = " << q << endl;

    cout << "\ny = 1/x\n";
    cout << "P(x) = " << Gauss(y1, q) << endl;

    cout << "\ny = x^5\n";
    cout << "P(x) = " << Gauss(y2, q) << endl;

    return 0;
}
