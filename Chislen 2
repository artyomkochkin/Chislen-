#include <iostream>
#include <iomanip>
#include <cmath>

using namespace std;

int main()
{
    setlocale(LC_ALL, "Russian");

    const int n = 7;

    double x[n] = {0.4, 0.7, 1.0, 1.3, 1.6, 1.9, 2.2};

    double y[n];

    // Таблица конечных разностей
    double d[n][n];

    // Значения функции
    for (int i = 0; i < n; i++)
        d[i][0] = 1.0 / x[i];

    // Конечные разности
    for (int j = 1; j < n; j++)
        for (int i = 0; i < n - j; i++)
            d[i][j] = d[i + 1][j - 1] - d[i][j - 1];

    cout << fixed << setprecision(6);

    cout << "Таблица конечных разностей для y = 1/x\n\n";

    cout << setw(8) << "x"
         << setw(12) << "y"
         << setw(12) << "Dy"
         << setw(12) << "D2y"
         << setw(12) << "D3y"
         << setw(12) << "D4y"
         << setw(12) << "D5y"
         << setw(12) << "D6y"
         << endl;

    for (int i = 0; i < n; i++)
    {
        cout << setw(8) << x[i];

        for (int j = 0; j < n - i; j++)
            cout << setw(12) << d[i][j];

        cout << endl;
    }

    // Центральный узел
    double x0 = 1.3;

    // Шаг
    double h = 0.3;

    // Точка интерполирования
    double X = 1.1;

    // q
    double q = (X - x0) / h;

    cout << "\nВторая интерполяционная формула Гаусса\n";
    cout << "x0 = " << x0 << endl;
    cout << "h  = " << h << endl;
    cout << "x  = " << X << endl;
    cout << "q  = " << q << endl;

    // Формула Гаусса
    double P = d[3][0];

    P += q * d[2][1];

    P += (q + 1) * q / 2.0 * d[2][2];

    P += (q + 1) * q * (q - 1) / 6.0 * d[1][3];

    P += (q + 2) * (q + 1) * q * (q - 1)
         / 24.0 * d[1][4];

    P += (q + 3) * (q + 2) * (q + 1) * q * (q - 1)
         / 120.0 * d[0][5];

    P += (q + 4) * (q + 3) * (q + 2) * (q + 1)
         * q * (q - 1) / 720.0 * d[0][6];

    cout << "\nP(x) = " << P << endl;

    return 0;
}
